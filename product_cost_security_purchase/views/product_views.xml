<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_view_form" model="ir.ui.view">
        <field name="name">product.template.form.cost.security.purchase</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="purchase.view_product_supplier_inherit" />
        <field name="arch" type="xml">
            <field name="seller_ids" position="attributes">
                <attribute
                    name="groups"
                >product_cost_security.group_product_cost</attribute>
            </field>
            <field name="seller_ids" position="after">
                <field
                    name="seller_ids"
                    groups="!product_cost_security.group_product_cost"
                    context="{'default_product_tmpl_id': id, 'product_template_invisible_variant': True, 'list_view_ref': 'purchase.product_supplierinfo_tree_view2'}"
                    nolabel="1"
                    invisible="product_variant_count &gt; 1"
                    readonly="product_variant_count &gt; 1"
                />
            </field>
        </field>
    </record>
    <record id="product_product_view_form" model="ir.ui.view">
        <field name="name">product.product.form.cost.security.purchase</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="purchase.view_product_product_supplier_inherit" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='seller_ids'][@groups='!product_cost_security.group_product_cost']"
                position="attributes"
            >
                <attribute
                    name="context"
                >{'default_product_tmpl_id': product_tmpl_id, 'product_template_invisible_variant': True, 'list_view_ref': 'purchase.product_product_supplierinfo_tree_view2'}</attribute>
            </xpath>
            <field name="variant_seller_ids" position="attributes">
                <attribute
                    name="groups"
                >product_cost_security.group_product_cost</attribute>
            </field>
            <field name="variant_seller_ids" position="after">
                <field
                    name="variant_seller_ids"
                    groups="!product_cost_security.group_product_cost"
                    context="{'model': 'product.product', 'active_id': id, 'list_view_ref': 'purchase.product_product_supplierinfo_tree_view2'}"
                    nolabel="1"
                    invisible="product_variant_count &lt;= 1"
                    readonly="product_variant_count &lt;= 1"
                />
            </field>
        </field>
    </record>
</odoo>
